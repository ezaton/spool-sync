# --- Required ---
# Spoolman REST base (note the /api/v1 suffix). No auth header is needed for a
# server-to-server client.
SPOOLMAN_URL=http://spoolman:8000/api/v1
# SpoolEase device base URL (no trailing path).
SPOOLEASE_URL=http://192.168.1.50

# --- SpoolEase read mode ---
# "json" (recommended): uses GET /api/spools.json added by the endpoint changeset.
# "encrypted": reads the stock AES-GCM blob (NOT implemented in phase 1).
SPOOLEASE_MODE=json
# Bearer token the JSON endpoint checks (set the same value on the device).
SPOOLEASE_TOKEN=change-me
# Only for SPOOLEASE_MODE=encrypted:
# SPOOLEASE_SECURITY_KEY=ABC1234

# --- Mapping defaults (see ../data-mapping.md) ---
DEFAULT_DIAMETER=1.75
DEFAULT_DENSITY=1.24

# --- Loop / behavior ---
SYNC_INTERVAL_SECONDS=30
DRY_RUN=false
ARCHIVE_MISSING=true
# Local run: a file in the working dir. In Docker this is set to /state/... (mount a volume).
STATE_PATH=./spoolsync-state.sqlite
LOG_LEVEL=INFO

# --- Phase 2: Two-way sync (requires SpoolEase JSON POST endpoint) ---
TWO_WAY_SYNC=false
# When enabled:
# - Listens to Spoolman websocket for real-time changes
# - Writes Spoolman-owned fields (location, comment) back to SpoolEase
# - Requires SPOOLEASE_MODE=json and the POST endpoint implemented
# See ../PHASE2-SPOOLEASE-ENDPOINT.md for endpoint specification
